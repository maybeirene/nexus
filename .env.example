# Copia este archivo a .env y cambia solo lo que necesites.
# No pongas contraseñas reales. No subas .env a Git.

# Aplicación
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Base de datos local. La carpeta data/ no se versiona.
DATABASE_URL=sqlite:///./data/nexus.db

# Modelo en este ordenador, servido por Ollama.
# En un Mac con 8 GB de memoria usa qwen3:4b.
# Con 16 GB o más puedes probar qwen3:8b.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Reservado para más adelante. Déjalo vacío hasta que exista login.
# Genera un valor aleatorio propio; no reutilices este texto.
SECRET_KEY=replace-with-a-random-local-secret

# Google Calendar. No hace falta para conversar en local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
